{
  "name": "mobius-ledger-v2",
  "version": "1.0.0",
  "description": "Mobius Ledger v2 - Financial Management System for Schools",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "db:setup": "cd backend && npm run db:setup",
    "db:seed": "cd database && node seed.js",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "lint:frontend": "cd frontend && npm run lint",
    "gatecheck": "npm run build:frontend && npm run test:backend && npm run test:frontend && npm run lint:frontend && npm run check:routes && npm run check:seed && npm run check:deps",
    "bootstrap:admin": "npm run bootstrap:admin --workspace=backend",
    "check:routes": "node scripts/gatecheck/route-protection-check.mjs",
    "check:seed": "node scripts/gatecheck/seed-safety-check.mjs",
    "check:deps": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "finance",
    "school",
    "ledger",
    "sqlite",
    "react",
    "express"
  ],
  "author": "Sami-rixx",
  "license": "MIT"
}

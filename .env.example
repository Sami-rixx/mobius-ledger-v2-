# Mobius Ledger v2 - Environment Configuration
# Copy this file to .env and update the values

# Backend Server Configuration
PORT=3000
NODE_ENV=development

# Host the backend binds to. Leave as 0.0.0.0 when running behind a
# reverse proxy (nginx/Caddy) on the same VPS, or set to 127.0.0.1 if you
# want to guarantee the app is only reachable via the proxy and never
# directly from outside the host.
HOST=0.0.0.0

# Set to "true" (or a hop count, e.g. "1") only when running behind a
# trusted reverse proxy that sets X-Forwarded-* headers. This affects how
# Express resolves req.ip (used for rate limiting and audit logging) and
# must never be enabled if the app is directly internet-facing, since it
# would let a client spoof its own IP via the X-Forwarded-For header.
TRUST_PROXY=false

# Frontend URL (for CORS) - must be the exact origin the browser loads the
# app from (scheme + host + port). Used as the CORS allowlist and is also
# where cookies are expected to be sent from.
FRONTEND_URL=http://localhost:5173

# Database Configuration (SQLite - file-based, no connection string needed)
# Default database file location: ./database/mobius_ledger.db
# Override to point at a persistent, secure-permissions path on the
# production host (see spec §13/§17 - single VPS/VM, persistent storage,
# regular encrypted off-site backups of this file).
# DATABASE_PATH=/var/lib/mobius-ledger/mobius_ledger.db

# Application Settings
# Currency is configured in the database (default: KES)
# Receipt prefix is configured in the database (default: ML)

# For production:
# PORT=443 (or 3000/8080 behind a reverse proxy that terminates TLS)
# NODE_ENV=production
# HOST=0.0.0.0
# TRUST_PROXY=1
# FRONTEND_URL=https://your-school-domain.com
# DATABASE_PATH=/var/lib/mobius-ledger/mobius_ledger.db
